# Real config holds secrets — never commit. Copy config.sample.php to config.php.
/config/config.php

# Composer
/vendor/

# Uploaded ticket attachments (user data, never commit)
/storage/uploads/
/public/uploads/*
!/public/uploads/.htaccess

# Gestionale customer exports: 10,000 people's personal data. The FTP drop
# directory and any export lying in the repo root stay out of history.
/storage/import/
*-CLIENTI.xlsx

# Signing: customer documents, sealed PDFs and — above all — the private key.
# Committing storage/sign/keys would make every signature we ever made forgeable.
/storage/sign/
# Private keys / cert bundles must never be committed, wherever they are dropped.
*.key
*.p12
*.pfx
# The certificates themselves are public, but they arrive in the same drop as
# the key and belong on the server, not in history.
*.cer
*.crt
*.pem

# Signed sample files produced to demonstrate the signature to a third party.
# Regenerate them rather than committing them.
/verifica-firma/

# Local logs / scratch
/logs/*.log
*.log
grep.exe.stackdump

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
mpesa_receipt_*.pdf
